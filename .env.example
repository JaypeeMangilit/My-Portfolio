# Resend API key — https://resend.com/api-keys
# Keep this secret. Never commit the real value.
RESEND_API_KEY=

# Sender address.
# Until you verify a domain in Resend, use their shared test address:
#   onboarding@resend.dev
# Limitation: it can only deliver to the email address registered with your
# Resend account, and recipients may see a "via resend.dev" note.
# Once a domain is verified, use something like: Portfolio <hello@your-domain.com>
# Sender address. Must be one of these two formats:
#   Portfolio Contact <onboarding@resend.dev>
#   onboarding@resend.dev
# The name and address must be in that order (name first, address inside <>).
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Inbox that receives inquiries.
CONTACT_TO_EMAIL=jaypeemangilit001@gmail.com
